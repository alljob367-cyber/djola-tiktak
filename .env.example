# ============================================================
# DJOLA TIKTAK — Variables d'environnement
# ⚠️ Les noms ci-dessous correspondent EXACTEMENT aux noms lus
# par le code. Ne pas les modifier (sinon la fonctionnalité
# associée tombera en mode « placeholder » silencieusement).
#
# Copie ce fichier en `.env.local` (développement local) ou
# renseigne les valeurs dans Vercel → Settings → Environment
# Variables (production).
# ============================================================

# ---------- BASE DE DONNÉES SUPABASE (OBLIGATOIRE) ----------
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# ---------- EMAILS TRANSACTIONNELS (Resend) ----------
# https://resend.com → API Keys
# ⚠️ Le code lit RESEND_FROM_EMAIL (et NON « EMAIL_FROM »).
# « onboarding@resend.dev » n'envoie qu'à l'e-mail du compte
# Resend : pour les vrais clients, vérifie ton domaine dans
# Resend → Domains puis mets une adresse sur ton domaine.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Djola TikTak <onboarding@resend.dev>"

# ---------- ADMINISTRATION (OBLIGATOIRE pour admin + crons) ----------
# ⚠️ Le code lit ADMIN_SECRET (et NON « ADMIN_SETUP_KEY »).
# ADMIN = profiles.role='admin' en base (migration admin-role-migration.sql,
# gérable dans /admin → Utilisateurs & Plans) OU e-mail listé dans ADMIN_EMAILS.
# ADMIN_SECRET protège /admin/setup (page de création des identifiants admin
# et des appels API programmatiques /api/admin/payments).
# ADMIN_EMAILS = liste d'e-mails séparés par des virgules, reconnus admins.
# Génère les clés avec : openssl rand -hex 32
ADMIN_SECRET=changez-cette-cle
ADMIN_EMAILS=ton-email@exemple.com
CRON_SECRET=changez-cette-cle-aussi

# ---------- URL DU SITE (liens e-mails, checkout, rappels) ----------
# ⚠️ Le code lit NEXT_PUBLIC_APP_URL (et NON « NEXT_PUBLIC_SITE_URL »).
NEXT_PUBLIC_APP_URL=https://djola-tiktak-gamma.vercel.app

# ---------- WHATSAPP : META CLOUD API (prioritaire) + TWILIO (fallback) ----------
# DOUBLE FOURNISSEUR avec détection automatique :
#   • Meta configuré → Meta utilisé (gratuit 1 000 conversations/mois,
#     listes/boutons interactifs du bot de réservation)
#   • Meta absent mais Twilio configuré → Twilio utilisé
#     (bot : listes remplacées par du texte numéroté)
#   • Les deux configurés → META PRIORITAIRE
# Utilisé par : les rappels de rendez-vous + le bot de réservation.
#
# ── Option A : META CLOUD API (recommandé — détail : DEPLOYMENT.md 7bis) ──
#   1. business.facebook.com → compte WhatsApp Business
#   2. developers.facebook.com → App → produit "WhatsApp" → API Setup
#   3. Copie le "Phone number ID" (PAS le numéro) + jeton permanent
#      (Business Settings → System Users → whatsapp_business_messaging)
# WHATSAPP_TOKEN=votre-jeton-permanent-meta
# WHATSAPP_PHONE_NUMBER_ID=id-du-numero-meta
# Template approuvé UTILITY pour les rappels hors fenêtre 24h (recommandé) :
# WHATSAPP_TEMPLATE_NAME=appointment_reminder
# WHATSAPP_TEMPLATE_LANG=fr
# WHATSAPP_API_VERSION=v21.0
#
# ── Option B : TWILIO WHATSAPP (fallback — sandbox facile) ──
# Console Twilio → Dashboard : Account SID + Auth Token
# Sandbox : Messaging → Try it out → Send a WhatsApp message → +1 415 523 8886
# ⚠️ Sandbox : le client doit d'abord envoyer "join <code>" au +1 415 523 8886
# (code visible dans la console Twilio) pour recevoir les messages.
# ⚠️ N'ajoute TWILIO_PHONE_NUMBER QUE si tu veux AUSSI les SMS payants
# (~0,32 $/SMS au Cameroun) — sinon le canal SMS reste en placeholder.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=votre-jeton-auth-twilio
# TWILIO_WHATSAPP_FROM=+14155238886
#
# Numéro de test pour scripts/test-whatsapp.js (détecte Meta ou Twilio)
# TEST_WHATSAPP_TO=+2376XXXXXXXX

# ---------- BOT DE RÉSERVATION WHATSAPP (Meta Cloud API) ----------
# Le client réserve EN CONVERSATION WhatsApp (bouton flottant sur la
# page publique → "RDV <slug>" → service → créneau → confirmation).
# ⚠️ Requiert WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID ci-dessus.
#
# 1) WHATSAPP_VERIFY_TOKEN : valeur libre que tu recopies dans
#    Meta App Dashboard → WhatsApp → Configuration → Verify token
#    (URL du callback : https://ton-domaine/api/whatsapp/webhook)
# 2) S'abonner au champ "messages" dans la même page.
# 3) NEXT_PUBLIC_WHATSAPP_BOOKING_NUMBER : le numéro WhatsApp de la
#    plateforme (format international sans "+", ex : 2376XXXXXXXX) —
#    c'est lui qui affiche le bouton flottant sur les pages publiques.
# WHATSAPP_VERIFY_TOKEN=changez-ce-jeton-verification
# NEXT_PUBLIC_WHATSAPP_BOOKING_NUMBER=2376XXXXXXXX

# ---------- ANTI-SPAM (rate limiting persistant) ----------
# Sel optionnel durcissant le hachage des IP dans rate_limit_hits.
# Recommandé en production : openssl rand -hex 16
# RATE_LIMIT_SALT=sel-aleatoire-16-octets

# ---------- RAPPELS SMS (optionnel — Africa's Talking OU Twilio) ----------
# Les SMS sont optionnels : WhatsApp + e-mail couvrent déjà les rappels.
# Priorité automatique : Africa's Talking (tarifs locaux africains)
# > Twilio (~0,32 $/SMS au Cameroun — déconseillé).
# ── Africa's Talking : https://africastalking.com
# AFRICASTALKING_API_KEY=votre-cle-api
# AFRICASTALKING_USERNAME=votre-username
# AFRICASTALKING_SENDER_ID=votre-sender-id
# ── Twilio SMS (fallback) : nécessite TWILIO_ACCOUNT_SID + AUTH_TOKEN
# (déjà définis ci-dessus pour WhatsApp) + ce numéro SMS :
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ---------- NORMALISATION DES NUMÉROS (optionnel) ----------
# Indicatif pays par défaut pour les numéros locaux (Cameroun)
DEFAULT_COUNTRY_CODE=237

# ---------- PAIEMENT EN LIGNE CHARIOW (Mobile Money) ----------
# CHARIOW_API_KEY=votre-cle-chariow
# CHARIOW_WEBHOOK_SECRET=votre-secret-webhook
# ⚠️ Sans les 6 IDs produits ci-dessous, le paiement en ligne
# démarre en 503 (seul Mobile Money manuel reste disponible).
# CHARIOW_PRODUCT_STARTER=id-produit-starter-mensuel
# CHARIOW_PRODUCT_PRO=id-produit-pro-mensuel
# CHARIOW_PRODUCT_BUSINESS=id-produit-business-mensuel
# CHARIOW_PRODUCT_STARTER_YEARLY=id-produit-starter-annuel
# CHARIOW_PRODUCT_PRO_YEARLY=id-produit-pro-annuel
# CHARIOW_PRODUCT_BUSINESS_YEARLY=id-produit-business-annuel

# ---------- PAIEMENT MANUEL MOBILE MONEY (optionnel) ----------
# NEXT_PUBLIC_MANUAL_PAYMENT_ENABLED=true
# NEXT_PUBLIC_MANUAL_PAYMENT_INSTRUCTIONS=Orange Money : 69X XX XX XX (nom : Djola)
# ORANGE_MONEY_NUMBER=+2376XXXXXXXX
# ORANGE_MONEY_NAME=Djola TikTak
# MTN_MOMO_NUMBER=+2376XXXXXXXX
# MTN_MOMO_NAME=Djola TikTak
# SUPPORT_PHONE=+2376XXXXXXXX

# ---------- IDENTITÉ SOCIÉTÉ (pages légales, e-mails) ----------
# Sans ces variables, des coordonnées fictives s'affichent.
# NEXT_PUBLIC_COMPANY_NAME=Djola TikTak
# NEXT_PUBLIC_COMPANY_LEGAL=société en cours de constitution
# NEXT_PUBLIC_COMPANY_ADDRESS=Douala, Cameroun
# NEXT_PUBLIC_SUPPORT_EMAIL=contact@ton-domaine.com
# NEXT_PUBLIC_SUPPORT_PHONE=+2376XXXXXXXX
